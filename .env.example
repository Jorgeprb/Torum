# Torum local environment
# Copy this file to .env before running Docker Compose.

PROJECT_NAME=Torum
ENVIRONMENT=local
TAILSCALE_ENABLED=false
PUBLIC_HOST=localhost

# Docker Compose exposure. Use 0.0.0.0 for LAN/Tailscale access.
API_BIND_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL / TimescaleDB
POSTGRES_DB=torum
POSTGRES_USER=torum
POSTGRES_PASSWORD=change-postgres-password
DATABASE_URL=postgresql+psycopg://torum:change-postgres-password@timescaledb:5432/torum

# Redis
REDIS_URL=redis://redis:6379/0

# Backend HTTP security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
TORUM_SERVICE_TOKEN=replace-with-a-second-long-random-secret
INTERNAL_AUTH_REQUIRED=true
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Initial users. Phase 1 supports only admin and trader roles.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@torum.dev
INITIAL_ADMIN_PASSWORD=change-admin-password
INITIAL_TRADER_USERNAME=trader
INITIAL_TRADER_EMAIL=trader@torum.dev
INITIAL_TRADER_PASSWORD=change-trader-password

# Trading safety defaults
TRADING_MODE=PAPER
MT5_BRIDGE_BASE_URL=http://host.docker.internal:9100
PRICE_STALE_AFTER_SECONDS=30
CANDLE_PRICE_SOURCE=BID
CHART_BROKER_TIME_ZONE=Etc/GMT-3
MOCK_MARKET_TICK_INTERVAL_SECONDS=1.0
LIVE_TRADING_ENABLED=false
DEFAULT_MAGIC_NUMBER=260426
DEFAULT_DEVIATION_POINTS=20

# News blocking defaults, implemented in later phases.
NEWS_BLOCK_ENABLED=false
NEWS_BLOCK_MINUTES_BEFORE=60
NEWS_BLOCK_MINUTES_AFTER=60
# Automatic economic calendar. Core sources (BLS, BEA, Federal Reserve and
# Census) require no account or API key. FMP is the single optional enrichment
# key for forecasts/previous/actual values and additional macro events.
FMP_ECONOMIC_CALENDAR_URL=https://financialmodelingprep.com/stable/economic-calendar
FMP_API_KEY=
NEWS_BLS_ICS_URL=https://www.bls.gov/schedule/news_release/bls.ics
NEWS_BEA_RELEASE_DATES_URL=https://apps.bea.gov/API/signup/release_dates.json
NEWS_CENSUS_CALENDAR_URL=https://www.census.gov/economic-indicators/calendar-listview.html
NEWS_FED_CALENDAR_BASE_URL=https://www.federalreserve.gov/newsevents
NEWS_PROVIDER_TIMEOUT_SECONDS=10

# Deprecated compatibility only. The TORUM provider no longer depends on Finnhub.
FINNHUB_CALENDAR_URL=https://finnhub.io/api/v1/calendar/economic
FINNHUB_API_KEY=

# PWA push notifications. Generate keys locally and do not commit real secrets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@torum.dev

# Reliability / synchronization
MT5_MISSING_POSITION_CONFIRMATIONS=3
MT5_ORDER_REQUEST_TIMEOUT_SECONDS=3
STRATEGY_RUN_ON_CANDLE_CLOSE_ONLY=true
RISK_RECOMPUTE_DEBOUNCE_SECONDS=0.5
RISK_USE_MT5_PROFIT_CALIBRATION=true
RISK_MT5_CALIBRATION_TIMEOUT_SECONDS=2.0
TRADE_JOB_POLL_INTERVAL_SECONDS=0.5
TRADE_JOB_MAX_ATTEMPTS=8
RUN_INTERNAL_SCHEDULERS=true
ENFORCE_SINGLE_WORKER=true

# Persistent diagnostics. Files appear in ./logs on the Docker host.
LOG_TO_FILES=true
LOG_DIRECTORY=/app/logs
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=20
STRATEGY_TRACE_ENABLED=true
STRATEGY_TRACE_RECENT_CANDLES=30
TORUM_RESERVATION_TTL_SECONDS=120
# SENT/RECONCILING reservations remain conservative until authoritative MT5 sync resolves them.
TORUM_AMBIGUOUS_RESERVATION_TTL_SECONDS=86400
TORUM_RECONCILIATION_GRACE_SECONDS=20
TORUM_RECONCILIATION_ABSENT_SYNCS=3
TORUM_MAX_ENTRY_DELAY_SECONDS=60
STRATEGY_SYMBOL_LOCK_TIMEOUT_SECONDS=1
STRATEGY_PIPELINE_WARN_MS=1000
STRATEGY_PIPELINE_HARD_TIMEOUT_SECONDS=4
MT5_DEALS_SYNC_INTERVAL_SECONDS=5
MT5_DEAL_CURSOR_OVERLAP_SECONDS=5
MT5_DEAL_CURSOR_FILE=.torum_mt5_deal_cursor.json

# Persistent MT5 bridge logs (empty directory uses <project>/logs/mt5_bridge).
MT5_LOG_TO_FILE=true
MT5_LOG_DIRECTORY=
MT5_LOG_MAX_BYTES=10000000
MT5_LOG_BACKUP_COUNT=20

MT5_POSITION_SYNC_INTERVAL_SECONDS=0.5

MT5_DEALS_HISTORY_LOOKBACK_DAYS=365
MT5_HISTORY_CHUNK_DAYS=7
# Include deals timestamped in broker-server wall time ahead of real UTC.
MT5_HISTORY_FUTURE_TOLERANCE_HOURS=14
